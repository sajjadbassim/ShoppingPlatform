<Project Sdk="Microsoft.NET.Sdk">

  <!-- أداة تطوير: تملأ قاعدة بيانات التطوير ببيانات محاكاة واقعية (متاجر، منتجات بصور، زبائن، طلبات، تقييمات) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ecommerce\ecommerce.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\products.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
